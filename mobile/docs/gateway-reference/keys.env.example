# 复制本文件为 keys.env 并填入密钥（keys.env 不会进入 git）
# 腾讯云机器翻译密钥：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=你的SecretId
TENCENT_SECRET_KEY=你的SecretKey
TENCENT_REGION=ap-guangzhou
# DeepSeek LLM（词典整理）：https://platform.deepseek.com 创建 API Key
DEEPSEEK_API_KEY=你的DeepSeekKey
DEEPSEEK_MODEL=deepseek-v4-flash
# 登录/云同步令牌签名密钥（随机长字符串，如 openssl rand -hex 32）
DIANDUJI_SYNC_SECRET=你的随机密钥
PORT=8080
